# Скопируйте в .env и заполните своими значениями:
#   copy .env.example .env
#
# BOT_TOKEN — от @BotFather
BOT_TOKEN=123456:REPLACE_WITH_REAL_TOKEN

# ADMIN_IDS — ваш Telegram user id (число). Несколько: 111,222
ADMIN_IDS=12345678

# Порт веб-сервера наружу (внутри контейнера всегда 8081)
WEB_PORT=8081
