# Скопируйте в .env и заполните своими значениями:
#   copy .env.example .env
#
# BOT_TOKEN — от @BotFather
BOT_TOKEN=123456:REPLACE_WITH_REAL_TOKEN

# ADMIN_IDS — ваш Telegram user id (число). Несколько: 111,222
ADMIN_IDS=12345678

# Порт веб-сервера наружу (внутри контейнера всегда 8081)
WEB_PORT=8081

# Bind веб (в Docker по умолчанию 0.0.0.0; на bare metal предпочтительно 127.0.0.1)
# WEB_BIND_HOST=127.0.0.1

# Опасный git reset --hard из админки (по умолчанию выкл.)
# ALLOW_FORCE_GIT_RESET=0

# Требовать Redis FSM в проде
# REQUIRE_REDIS_FSM=0

# GITHUB_REPO_URL=https://github.com/YOUR_USER/OpenGate.git
